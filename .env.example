# Copy this file to .env and fill in the values.

# --- Hugging Face ---
# Required for downloading ALLaM-7B (gated), Qwen2.5-7B, and bge-* models.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Synthetic Q&A generation (Phase 1, week 2) ---
# Pick one provider. Only used offline to build training data; NOT used at inference.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Wikipedia ---
# A descriptive User-Agent is required by the Wikipedia API policy.
# Include a contact email so they can reach you if your scraper misbehaves.
WIKIPEDIA_USER_AGENT=WorldCupRAG/0.1.0 (your-email@example.com)

# --- Runtime ---
APP_ENV=dev
LOG_LEVEL=INFO
